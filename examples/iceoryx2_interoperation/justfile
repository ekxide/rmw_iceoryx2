# Build the iceoryx2 interoperation example.
# Invoked by the root build-example recipe; runnable directly from the workspace root.

ws := invocation_directory()
root := justfile_directory() / "../../justfile"

# Build the ROS 2 packages and native iceoryx2 nodes.
build:
    #!/usr/bin/env bash
    set -eo pipefail

    cd "{{ws}}"
    just -f "{{root}}" build rmw_iceoryx2_interoperation_demo_nodes iceoryx2_interoperation_demo_nodes
